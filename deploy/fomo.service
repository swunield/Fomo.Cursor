[Unit]
Description=FOMO Desk (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Fomo
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/Fomo/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787 --workers 1 --timeout-keep-alive 75
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
